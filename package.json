{
  "name": "lol-tracker-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de LoL Tracker: guarda la API key de Riot en el servidor, cachea en PostgreSQL y reparte el límite de peticiones entre todos los usuarios.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.85.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
