# Copia este archivo como .env (no se sube a git).
PORT=3000
DATABASE_URL=postgres://lol:lol@localhost:5432/lol_api
# Tu key de https://developer.riotgames.com (Development o Personal). Solo la conoce el servidor.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Opcional: si se define, las apps tienen que enviar la cabecera X-App-Token con este valor.
APP_TOKEN=
# Peticiones por minuto que puede hacer cada cliente (IP o token).
CLIENT_RATE_LIMIT_PER_MINUTE=120
